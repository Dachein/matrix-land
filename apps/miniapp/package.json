{
  "name": "@workspace/miniapp",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "dev:weapp": "taro build --type weapp --watch",
    "dev:h5": "taro build --type h5 --watch",
    "build:weapp:test": "TARO_APP_USE_MOCKS=0 TARO_APP_API_BASE=https://ai.example.invalid taro build --type weapp",
    "dev:weapp:test": "TARO_APP_USE_MOCKS=0 TARO_APP_API_BASE=https://ai.example.invalid taro build --type weapp --watch",
    "build:weapp:prod": "TARO_APP_USE_MOCKS=0 TARO_APP_API_BASE=https://ai.example.invalid taro build --type weapp",
    "verify:package": "node scripts/verify-package.mjs",
    "test": "node --experimental-strip-types --import ./scripts/ts-resolve-bootstrap.mjs --test src/services/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "domhandler": "4.2.2",
    "htmlparser2": "6.1.0",
    "markdown-it": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^18.3.24",
    "babel-preset-taro": "4.2.1",
    "sass": "^1.92.1",
    "typescript": "^5.8.0",
    "webpack": "5.91.0"
  }
}
