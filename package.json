{
  "name": "frontier-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run sdk:build && tsc -p apps/portal/tsconfig.json && vite build",
    "sdk:build": "npm --prefix packages/mate-sdk run build",
    "typecheck": "npm run sdk:build && tsc --noEmit && tsc -p apps/portal/tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "test:portal": "node scripts/test.mjs portal",
    "test:api": "node scripts/test.mjs api",
    "test:installer": "node --test packages/installer/test/*.test.mjs",
    "test:quality": "npm run typecheck && npm run test && npm run build",
    "test:e2e": "playwright test",
    "setup": "node packages/installer/src/cli.mjs serve",
    "setup:plan": "node packages/installer/src/cli.mjs plan",
    "setup:apply": "node packages/installer/src/cli.mjs apply",
    "upgrade": "node packages/installer/src/cli.mjs upgrade",
    "design:tokens": "node --experimental-strip-types scripts/generate-design-tokens.mjs",
    "quality:design-system": "node --experimental-strip-types scripts/generate-design-tokens.mjs --check && node --experimental-strip-types scripts/design-system-check.mjs",
    "quality:frontend-css": "node scripts/frontend-css-health.mjs",
    "quality:frontend-i18n": "node scripts/frontend-i18n-health.mjs",
    "portal:artifact:verify": "node scripts/verify-portal-artifact.mjs",
    "sdk:bundle": "node scripts/build-auth-sdk-package.mjs && node scripts/build-mail-sdk-package.mjs",
    "release:source": "node scripts/package-source.mjs",
    "verify:deployment": "node --experimental-strip-types scripts/verify-deployment.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.39",
    "@ai-sdk/openai": "4.0.43",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@ai-sdk/react": "^4.0.68",
    "@blocknote/core": "^0.56.0",
    "@blocknote/mantine": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "@cloudflare/ai-chat": "^0.12.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fontsource/chakra-petch": "^5.3.0",
    "@noble/hashes": "2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "agents": "^0.32.0",
    "ai": "^7.0.65",
    "echarts": "6.1.0",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.2",
    "ignore": "^7.0.6",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.2.0",
    "mimetext": "^3.0.28",
    "postal-mime": "^2.7.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@playwright/test": "^1.61.1",
    "@types/markdown-it": "^14.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261023.3-beta",
    "postcss": "^8.5.26",
    "typescript": "^5.8.0",
    "vite": "^8.3.5",
    "wrangler": "^4.106.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "MIT"
}
