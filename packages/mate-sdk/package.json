{
  "name": "@frontier-workspace/mate-sdk",
  "version": "0.1.0",
  "description": "Workspace Mate 3.0 SDK Host and Cloudflare Agents React adapter.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    }
  },
  "scripts": {
    "build": "tsc -p ../../sdk/mate/tsconfig.build.json && tsc -p tsconfig.build.json",
    "test": "npm run build && node --test src/*.test.mjs",
    "prepack": "npm run test"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@ai-sdk/react": "^4.0.0",
    "@cloudflare/ai-chat": ">=0.10.1 <1",
    "@frontier-workspace/mate": "^0.1.0-preview.1",
    "agents": ">=0.20.1 <1",
    "ai": "^7.0.0",
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.68",
    "@cloudflare/ai-chat": "^0.10.1",
    "@types/react": "^19.2.17",
    "agents": "^0.20.1",
    "ai": "^7.0.65",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "zod": "^4.4.3"
  }
}
