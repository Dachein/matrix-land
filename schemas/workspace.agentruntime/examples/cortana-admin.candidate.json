{
  "schemaVersion": "workspace.agentruntime/v1",
  "mate": {
    "mateId": "cortana",
    "displayName": "Cortana",
    "jobRole": "Review Workspace Forum updates, organize action items, and manage email tasks for AI Adoption",
    "description": "The first Inbox-first Frontier Workspace platform operations Mate.",
    "ownerUserId": "3634bd9b-137f-41f8-9a3c-20e8914c0c84",
    "addresses": [
      { "type": "email", "address": "cortana@mate.example.invalid" },
      { "type": "pass_mcp", "tool": "mate_call" }
    ]
  },
  "release": {
    "releaseId": "cortana-r1",
    "version": 1,
    "status": "candidate",
    "soul": {
      "id": "cortana-soul",
      "version": 1,
      "digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
    },
    "handbooks": [
      {
        "id": "cortana-handbook",
        "version": 1,
        "digest": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
      }
    ],
    "skills": []
  },
  "resources": {
    "mcpCapacity": {
      "ai_capacity": { "mode": "none" },
      "forum_hub": { "mode": "selected", "children": ["forum_read"] }
    },
    "appMcpBindings": [],
    "knowledgeServiceBindings": [],
    "builtInToolBindings": [
      { "toolId": "todo_manage", "requiresCurrentUserContext": true },
      { "toolId": "reminder_manage", "requiresCurrentUserContext": true }
    ],
    "skillDiscoveryPolicy": {
      "discoverAndRecommend": true,
      "autoInstall": false,
      "installationRequests": false
    }
  },
  "modelPolicy": {
    "defaultModel": "tencent-deepseek-v4-flash",
    "allowedModels": ["tencent-deepseek-v4-flash"],
    "allowUserSelection": false,
    "multimodal": {
      "imageInput": true,
      "documentInput": true,
      "audioInput": false
    }
  },
  "channels": {
    "standalone": { "enabled": false },
    "embedded": { "enabled": false },
    "inbox": {
      "email": { "enabled": true },
      "mateCall": {
        "enabled": true,
        "transport": "workspace_pass_mcp",
        "tool": "mate_call"
      },
      "schedule": { "enabled": true },
      "webhook": { "enabled": false }
    }
  },
  "invocationPolicy": {
    "visibility": "organization",
    "requireAuthenticatedUser": true,
    "allowedCallerKinds": ["user", "app", "mate", "email_binding"]
  },
  "eligibilityPolicy": {
    "denyIfRequirementUnknown": true,
    "resourceRequirements": []
  },
  "preferenceSchema": {
    "version": 1,
    "fields": [
      { "key": "language", "type": "enum", "sensitive": false, "allowedValues": ["zh-CN", "en"] },
      { "key": "responseDensity", "type": "enum", "sensitive": false, "allowedValues": ["brief", "normal", "detailed"] }
    ]
  },
  "taskPolicy": {
    "requireUserOwnership": true,
    "conclusionRequired": true,
    "defaultTimezone": "Asia/Shanghai",
    "scheduledJobs": [
      {
        "id": "reminder_cortana_forum_daily",
        "title": "Workspace Forum daily review",
        "instruction": "Review Workspace Forum updates, summarize changes, and create concrete AI Adoption action items.",
        "cadence": { "kind": "daily", "at": "09:00", "timezone": "Asia/Shanghai" },
        "delivery": { "channel": "email", "recipient": "owner" }
      }
    ],
    "approvals": {
      "writeRiskLevels": ["medium", "high", "critical"],
      "singleUse": true,
      "revalidateDelegation": true
    },
    "mateCallLimits": {
      "maxDepth": 3,
      "maxChildrenPerTask": 8,
      "maxTasksPerRoot": 24,
      "maxRunSeconds": 1800
    }
  },
  "memoryPolicy": {
    "conversationHistory": {
      "enabled": false,
      "preserveOriginals": true,
      "compaction": {
        "enabled": false,
        "strategy": "non_destructive_overlay",
        "triggerEstimatedTokens": 64000,
        "protectHeadMessages": 3,
        "tailTokenBudget": 16000,
        "minTailMessages": 4,
        "maxSummaryTokens": 4000
      }
    },
    "userMemory": {
      "storage": "structured_runtime_api",
      "automaticConversationExtraction": false,
      "freeformFiles": false
    }
  },
  "experiencePolicy": {
    "automaticHandbookMutation": false,
    "requiresSanitization": true,
    "requiresReview": true,
    "conversation": {
      "enabled": false,
      "channels": []
    },
    "taskInbox": {
      "enabled": true,
      "channels": ["mate_call", "email", "schedule"]
    },
    "ownerTesting": {
      "enabled": true,
      "candidateReleaseOnly": true,
      "isolatedFromLiveData": true
    }
  }
}
