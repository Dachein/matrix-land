{
  "schemaVersion": "workspace.agentruntime/v1",
  "mate": {
    "mateId": "portfolio-banker-assistant",
    "displayName": "Portfolio Banker Mate",
    "jobRole": "Help authorized bankers review portfolios and complete controlled follow-up work",
    "description": "The write-capable candidate used to validate shared Runtime authorization and Approval.",
    "ownerUserId": "user_publisher",
    "addresses": [
      { "type": "email", "address": "portfolio-banker@agents.example.com" },
      { "type": "pass_mcp", "tool": "mate_call" }
    ]
  },
  "release": {
    "releaseId": "portfolio-banker-assistant-r1",
    "version": 1,
    "status": "candidate",
    "soul": {
      "id": "portfolio-banker-assistant-soul",
      "version": 1,
      "digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
    },
    "handbooks": [
      {
        "id": "portfolio-banker-runtime-handbook",
        "version": 1,
        "digest": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
      }
    ],
    "skills": [
      {
        "skillId": "portfolio-review",
        "version": "1.0.0",
        "digest": "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
      }
    ]
  },
  "resources": {
    "mcpCapacity": {
      "ai_capacity": { "mode": "selected", "children": ["web", "image", "video", "audio"] },
      "forum_hub": { "mode": "selected", "children": ["forum_read", "forum_write"] }
    },
    "appMcpBindings": [
      {
        "appId": "portfolio-tracker",
        "manifestVersion": "workspace.app-mcp/v1",
        "allowedToolNames": [
          "portfolio_client_read",
          "portfolio_follow_up_list",
          "portfolio_client_update"
        ],
        "requiresCurrentUserDelegation": true
      }
    ],
    "knowledgeServiceBindings": [
      {
        "serviceId": "portfolio-policies",
        "allowedOperations": ["search", "read"],
        "requiresCurrentUserAuthorization": true
      }
    ],
    "builtInToolBindings": [
      { "toolId": "document_read", "requiresCurrentUserContext": true },
      { "toolId": "artifact_create", "requiresCurrentUserContext": true },
      { "toolId": "todo_manage", "requiresCurrentUserContext": true },
      { "toolId": "reminder_manage", "requiresCurrentUserContext": true }
    ],
    "skillDiscoveryPolicy": {
      "discoverAndRecommend": true,
      "autoInstall": false,
      "installationRequests": false
    }
  },
  "modelPolicy": {
    "defaultModel": "tencent-deepseek-v4-flash",
    "allowedModels": ["tencent-deepseek-v4-flash"],
    "allowUserSelection": false,
    "multimodal": {
      "imageInput": true,
      "documentInput": true,
      "audioInput": false
    }
  },
  "channels": {
    "standalone": { "enabled": true },
    "embedded": { "enabled": true },
    "inbox": {
      "email": { "enabled": true },
      "mateCall": {
        "enabled": true,
        "transport": "workspace_pass_mcp",
        "tool": "mate_call"
      },
      "schedule": { "enabled": false },
      "webhook": { "enabled": false }
    }
  },
  "invocationPolicy": {
    "visibility": "organization",
    "requireAuthenticatedUser": true,
    "allowedCallerKinds": ["user", "app", "mate", "email_binding"]
  },
  "eligibilityPolicy": {
    "denyIfRequirementUnknown": true,
    "resourceRequirements": [
      {
        "resourceType": "app_mcp",
        "resourceId": "portfolio-tracker",
        "requiredCapability": "write_member"
      }
    ]
  },
  "preferenceSchema": {
    "version": 1,
    "fields": [
      { "key": "language", "type": "enum", "sensitive": false, "allowedValues": ["zh-CN", "en"] },
      { "key": "responseDensity", "type": "enum", "sensitive": false, "allowedValues": ["brief", "normal", "detailed"] }
    ]
  },
  "taskPolicy": {
    "requireUserOwnership": true,
    "conclusionRequired": true,
    "defaultTimezone": "Asia/Shanghai",
    "scheduledJobs": [],
    "approvals": {
      "writeRiskLevels": ["medium", "high", "critical"],
      "singleUse": true,
      "revalidateDelegation": true
    },
    "mateCallLimits": {
      "maxDepth": 3,
      "maxChildrenPerTask": 8,
      "maxTasksPerRoot": 24,
      "maxRunSeconds": 3600
    }
  },
  "memoryPolicy": {
    "conversationHistory": {
      "enabled": true,
      "preserveOriginals": true,
      "compaction": {
        "enabled": true,
        "strategy": "non_destructive_overlay",
        "triggerEstimatedTokens": 64000,
        "protectHeadMessages": 3,
        "tailTokenBudget": 16000,
        "minTailMessages": 4,
        "maxSummaryTokens": 4000
      }
    },
    "userMemory": {
      "storage": "structured_runtime_api",
      "automaticConversationExtraction": false,
      "freeformFiles": false
    }
  },
  "experiencePolicy": {
    "automaticHandbookMutation": false,
    "requiresSanitization": true,
    "requiresReview": true,
    "conversation": {
      "enabled": true,
      "channels": ["web", "sdk"]
    },
    "taskInbox": {
      "enabled": true,
      "channels": ["mate_call", "email"]
    },
    "ownerTesting": {
      "enabled": true,
      "candidateReleaseOnly": true,
      "isolatedFromLiveData": true
    }
  }
}
